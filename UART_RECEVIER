`timescale 1ns / 1ps
module uart_receiver(
    input       clk,
    input       rst,
    input       rx,
    input       rdy_clr,
    input       clken,
    output reg  rdy,
    output reg [7:0] data_out
);

    parameter RX_STATE_START = 2'b00;
    parameter RX_STATE_DATA  = 2'b01;
    parameter RX_STATE_STOP  = 2'b10;

    reg [1:0] state;
    reg [3:0] sample;
    reg [3:0] index;
    reg [7:0] scratch;

    always @(posedge clk) begin
        if (rst) begin
            state    <= RX_STATE_START;
            sample   <= 4'd0;
            index    <= 4'd0;
            scratch  <= 8'd0;
            rdy      <= 1'b0;
            data_out <= 8'd0;
        end else begin
            if (rdy_clr)
                rdy <= 1'b0;

            if (clken) begin
                case (state)
                    RX_STATE_START: begin
                        if (!rx || sample != 4'd0)
                            sample <= sample + 4'd1;
                        if (sample == 4'd15) begin
                            state   <= RX_STATE_DATA;
                            index   <= 4'd0;
                            sample  <= 4'd0;
                            scratch <= 8'd0;
                        end
                    end

                    RX_STATE_DATA: begin
                        sample <= sample + 4'd1;
                        if (sample == 4'h8)
                            scratch <= {rx, scratch[7:1]};
                        index <= index + 4'd1;
                        if (index == 4'd8 && sample == 4'd15)
                            state <= RX_STATE_STOP;
                    end

                    RX_STATE_STOP: begin
                        if (sample == 4'd15) begin
                            state    <= RX_STATE_START;
                            data_out <= scratch;
                            rdy      <= 1'b1;
                            sample   <= 4'd0;
                        end else begin
                            sample <= sample + 4'd1;
                        end
                    end

                    default: state <= RX_STATE_START;
                endcase
            end
        end
    end

endmodule
